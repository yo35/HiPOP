# Generate the type stubs for module `hipop.cpp`.
#
# Variables to be set at configure time:
# - Python_EXECUTABLE: python interpreter that the extension is built for (used to run nanobind.stubgen).
# - HIPOP_STUBS_DIR: directory where nanobind.stubgen writes the stubs.

# Remove the output of previous runs, if any.
file(REMOVE_RECURSE "@HIPOP_STUBS_DIR@")

# Stub generation using the stubgen tool shipped with nanobind.
# The stubs of `hipop.cpp` and of its submodules are written in `<output-dir>/cpp/`.
execute_process(
    COMMAND "@Python_EXECUTABLE@" -m nanobind.stubgen --module hipop.cpp --recursive --output-dir "@HIPOP_STUBS_DIR@/hipop"
    WORKING_DIRECTORY "${CMAKE_INSTALL_PREFIX}" # `python -m` adds the working directory to the module search path.
    COMMAND_ERROR_IS_FATAL ANY
)
